# Git
.git
.gitignore

# Logs and temp files
log/*
tmp/*
*.log

# SQLite databases — created fresh inside container
*.sqlite3
*.sqlite3-journal
*.sqlite3-shm
*.sqlite3-wal
db/*.sqlite3

# Test artifacts
coverage/
.rspec_status

# OS and editor files
.DS_Store
.idea/
.vscode/

# Don't copy user_code — it's mounted at runtime, not baked in
user_code/
